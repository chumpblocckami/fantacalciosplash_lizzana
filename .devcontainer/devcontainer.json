{
  "name": "Fantacalciosplash Lizzana",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    // scripts/assign_quotazioni.py is run with uv, between editions.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "Readme.md",
        "index.html"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "updateContentCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh; echo '✅ Ready'",
  // The site is static: there is nothing to build, only files to serve.
  "postAttachCommand": {
    "server": "npm run serve"
  },
  "portsAttributes": {
    "8080": {
      "label": "Fantacalciosplash",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8080
  ]
}
